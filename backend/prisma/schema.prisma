generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SPPG_OPERATOR
  SCHOOL_PIC
}

enum DistributionStatus {
  PERSIAPAN
  MEMASAK
  DIKIRIM
  DITERIMA
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(SCHOOL_PIC)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  sppg      Sppg?    @relation(fields: [sppgId], references: [id])
  sppgId    String?
  school    School?  @relation(fields: [schoolId], references: [id])
  schoolId  String?
}

model School {
  id            String   @id @default(uuid())
  name          String
  location      String
  contactNumber String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  users         User[]
  distributions Distribution[]
}

model Sppg {
  id            String   @id @default(uuid())
  name          String
  location      String
  contactNumber String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  users             User[]
  distributions     Distribution[]
  performanceScores PerformanceScore[]
}

model Menu {
  id            String   @id @default(uuid())
  name          String
  description   String?
  calories      Float
  protein       Float
  carbs         Float
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  distributions Distribution[]
}

model Distribution {
  id           String             @id @default(uuid())
  date         DateTime
  status       DistributionStatus @default(PERSIAPAN)
  deliveryToken String?
  
  sppgId       String
  sppg         Sppg               @relation(fields: [sppgId], references: [id])
  
  schoolId     String
  school       School             @relation(fields: [schoolId], references: [id])
  
  menuId       String
  menu         Menu               @relation(fields: [menuId], references: [id])
  
  foodWasteLog FoodWasteLog?
  
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model FoodWasteLog {
  id               String       @id @default(uuid())
  distributionId   String       @unique
  distribution     Distribution @relation(fields: [distributionId], references: [id])
  
  imageBefore      String?
  imageAfter       String?
  wastePercentage  Float?
  caloriesWasted   Float?
  
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model PerformanceScore {
  id             String   @id @default(uuid())
  sppgId         String
  sppg           Sppg     @relation(fields: [sppgId], references: [id])
  
  evaluationDate DateTime
  score          Float
  
  createdAt      DateTime @default(now())
}
